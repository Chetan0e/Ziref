# App Configuration
APP_ENV=development
BASE_DOMAIN=localhost:8080
API_PUBLIC_URL=http://localhost:8000
DASHBOARD_PUBLIC_URL=http://localhost:3000

# Databases
MONGODB_URI=mongodb://localhost:27017/ziref
REDIS_URL=redis://localhost:6379/0

# Security
JWT_SECRET=ziref_super_secret_jwt_key_replace_in_production_2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENCRYPTION_KEY=D7p0..........

# Storage Provider (local or s3)
STORAGE_PROVIDER=local
STORAGE_PATH=./storage

# Build Execution Constraints
BUILD_CPU_LIMIT=1.0
BUILD_MEMORY_LIMIT=1024m
BUILD_TIMEOUT_SECONDS=300
WORKER_CONCURRENCY=2

# Docker Sandbox Image
SANDBOX_IMAGE=node:20-alpine
